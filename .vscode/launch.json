  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch React App",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/shipment-planner-ui",
      "command": "npm run dev"
    },
    {
      "name": "Py Debugger: Placement Engine",
      "type": "debugpy",
      "cwd": "${workspaceFolder}/solver",
      "request": "launch",
      "program": "app.py",
      "console": "integratedTerminal"
    }
  ]
}
