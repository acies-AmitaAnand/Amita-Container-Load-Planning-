{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Launch React App",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/shipment-planner-ui",
      "command": "npm run dev"
    },
    {
      "name": "Py: Placement Engine",
      "type": "debugpy",
      "cwd": "${workspaceFolder}/solver",
      "request": "launch",
      "program": "app.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Py: FastAPI Server",
      "type": "debugpy",
      "cwd": "${workspaceFolder}/solver",
      "module": "uvicorn",
      "request": "launch",
      "console": "integratedTerminal",
      "args": ["fastapi-main:app", "--host", "0.0.0.0", "--port", "80", "--reload"]
    }
  ]
}
